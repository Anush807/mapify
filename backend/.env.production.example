# Production values for the deployed API (api.mapify.info).
# Set these in your host's environment/secrets UI — do not commit real values.
#
# The app is on https://www.mapify.info (Vercel) and the API on its own
# subdomain. Those are different ORIGINS but the same SITE (mapify.info), so the
# httpOnly auth cookie keeps working with SameSite=Strict — CORS is required,
# SameSite=None is not.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://...      # Neon, with ?sslmode=require
JWT_SECRET=                        # 16+ chars; rotating it logs everyone out

# Exact browser origin(s) allowed to call the API, comma-separated.
# No quotes around the values — dotenv keeps them and they end up inside the
# split strings, so nothing matches.
CORS_ORIGIN=https://www.mapify.info

# Single URL, not a list: it is concatenated into verification links and used as
# the post-OAuth redirect target.
FRONTEND_URL=https://www.mapify.info

# On the API origin — this is where Google sends the browser back.
# Must be registered verbatim in the Google Cloud console.
GOOGLE_CALLBACK_URL=https://api.mapify.info/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AI_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=

EMAIL_PROVIDER=resend
EMAIL_FROM=Mapify <no-reply@mapify.info>   # domain must be verified in Resend
RESEND_API_KEY=
EMAIL_VERIFICATION_EXPIRY_HOURS=24
