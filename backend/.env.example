DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mapify?schema=public"
JWT_SECRET=
PORT=
CORS_ORIGIN=

# gemini | openai | claude | mock
AI_PROVIDER=
# Alias by default so model retirements do not break generation.
# Free-tier request quota is counted PER MODEL per day.
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Auth: Google OAuth ---
# NOTE: this project runs the API on :3000 and the app on :5173. The spec's
# example used :5000/:3000, which would point verification links at the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# --- Auth: email sending ---
# resend | smtp | log   (log prints the email to stdout — no credentials needed)
EMAIL_PROVIDER=log
EMAIL_FROM="Mapify <no-reply@mapify.local>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

EMAIL_VERIFICATION_EXPIRY_HOURS=24
