# Build-time only (Vite inlines these). Copy to .env.local for local overrides.

# Where the API lives. Leave unset for local dev and the Docker stack — both
# serve the API from the same origin under /api.
# In production the API is on its own subdomain, so set this in Vercel:
#   VITE_API_URL=https://api.mapify.info/api
VITE_API_URL=
