# Copy to .env and adjust. Read by `docker compose` (not by the app directly —
# backend/.env is only used when running the API outside Docker).

# --- required ---------------------------------------------------------------
# 16+ characters. Changing it invalidates every existing session.
JWT_SECRET=change-me-to-something-long-and-random

# --- where the app is reached in a browser ----------------------------------
# Must match the port you publish below: it becomes the verification-link host
# and the OAuth redirect target.
APP_URL=http://localhost:8090

# --- published ports --------------------------------------------------------
WEB_PORT=8090
API_PORT=3001
DB_PORT=5435

# --- database ---------------------------------------------------------------
POSTGRES_USER=mapify
POSTGRES_PASSWORD=mapify
POSTGRES_DB=mapify

# --- AI provider ------------------------------------------------------------
# mock needs no credentials and keeps the whole flow usable offline.
# gemini | openai | claude | mock
AI_PROVIDER=mock
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- email ------------------------------------------------------------------
# log prints the verification link to the API's container logs — no credentials.
# resend | smtp | log
EMAIL_PROVIDER=log
EMAIL_FROM=Mapify <no-reply@mapify.local>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Google OAuth (optional) -------------------------------------------------
# Leave blank to disable; the app degrades to email/password with a clear notice.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8090/api/auth/google/callback

# --- advanced ---------------------------------------------------------------
# production makes the auth cookie Secure — fine on http://localhost, but it
# will not be set over plain HTTP on any other host. See the README.
NODE_ENV=production
